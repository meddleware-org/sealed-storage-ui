{
  "name": "@meddleware/sealed-storage-ui",
  "version": "0.0.49",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/sealed-storage/",
  "description": "Standalone Vue 3 SPA for Sealed Storage — client-side Seal encryption + access-gated, decentralised Walrus storage on Sui.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/sealed-storage-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md",
    "!src/e2e*.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:e2e": "VITE_E2E=1 vite build --mode e2e",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "mw-third-party-licenses",
    "check:licenses": "mw-third-party-licenses --check",
    "shots": "SHOTS=1 playwright test",
    "lhci": "npm run build && lhci autorun",
    "check:bundle": "check-prod-bundle dist --also 'e2e session key'",
    "check:csp": "mw-check-csp-inline @Dockerfile dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.13",
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/sealed-storage-client": "^0.0.26",
    "@meddleware/ui": "^0.1.41",
    "@meddleware/walrus-storage-client": "^0.0.34",
    "@meddleware/web-utils": "^0.0.4",
    "@mysten/sui": "^2.33.2",
    "@mysten/wallet-standard": "^0.21.0",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@meddleware/wallet-adapter": ">=0.0.22 <0.2.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@meddleware/frontend-config": "^0.0.8",
    "@meddleware/wallet-adapter": "^0.0.22",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.49",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "meddleware": {
    "kind": "app",
    "csp": "chain",
    "lhci": true
  }
}
